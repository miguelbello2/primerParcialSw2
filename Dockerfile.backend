FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libglib2.0-0 \
    libgomp1 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Correr sin root: varias PaaS lo exigen y ninguna lo penaliza. Sin un usuario
# propio, escribir en uploads/ o results/ falla con permiso denegado.
RUN useradd -m -u 1000 appuser
USER appuser
ENV PATH=/home/appuser/.local/bin:$PATH \
    HOME=/home/appuser

WORKDIR /app

# torch CPU-only: el wheel por defecto arrastra ~2.5GB de CUDA que en un tier
# gratuito no se usa. Se instala antes que el resto para que ultralytics lo
# encuentre satisfecho y no vuelva a resolver la variante CUDA.
RUN pip install --no-cache-dir --user \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.5.1 torchvision==0.20.1

COPY --chown=appuser requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

COPY --chown=appuser backend/ .
COPY --chown=appuser models/ ./models/

RUN mkdir -p uploads results logs

# ultralytics y matplotlib escriben config en $HOME al arrancar; apuntarlos a
# rutas propias evita que fallen si el HOME del runtime es de solo lectura.
ENV PORT=7860 \
    PYTHONUNBUFFERED=1 \
    YOLO_CONFIG_DIR=/app/logs \
    MPLCONFIGDIR=/app/logs

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# 1 worker: el estado (active_tasks, stream_stats, latest_uploaded_file) vive en
# memoria del proceso, así que varios workers servirían datos inconsistentes.
# --timeout 0: el endpoint MJPEG deja la respuesta abierta indefinidamente y el
# timeout por defecto de gunicorn mataría al worker a mitad del stream.
# 16 hilos: cada <img> del stream ocupa uno mientras el cliente siga conectado,
# y una pestaña recargada varias veces los acumula hasta bloquear los uploads.
CMD gunicorn --bind 0.0.0.0:${PORT} \
    --workers 1 --threads 16 \
    --timeout 0 \
    --log-level info \
    app:app
